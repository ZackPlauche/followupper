# Django Settings (Backend)
SECRET_KEY=your-secret-key-here
DEBUG=True
DATABASE_URL=sqlite:///followupper.db

# CORS Allowed Origins (Backend)
# Comma-separated list of allowed frontend origins
# For development: http://localhost:4000,http://127.0.0.1:4000
# For production: Add your Netlify domain (e.g., https://your-app.netlify.app)
# Example: CORS_ALLOWED_ORIGINS=http://localhost:4000,https://your-app.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Frontend Settings
# API Base URL (Frontend)
# For development, this defaults to http://localhost:8001/api
# For production, set this to your Railway backend URL
NUXT_PUBLIC_API_BASE=http://localhost:8001/api

# Note: Gmail credentials are stored in the database via the Settings page
# No need to configure them here - they're managed through the frontend
